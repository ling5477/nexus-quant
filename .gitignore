# Backend build outputs
backend/**/target/

# Frontend build outputs
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
*.tsbuildinfo

# Python / tool caches
research/py/.pytest_cache/
research/py/.ruff_cache/
research/py/.mypy_cache/
research/py/.venv/
research/py/.pip-tmp*/
research/py/pytest-cache-files-*/
__pycache__/
*.pyc

# IDE / editor
.idea/
*.iml
*.ipr
*.iws
.vscode/
.qoder/

# OS / logs / temp
.DS_Store
Thumbs.db
*.log
*.out
*.err
nohup.out
*.pid
*.tmp
*.temp

# Environment files
.env
.env.*
!.env.example
!frontend/.env.example
!deploy/.env.freeze.example

# Local secrets / certificates
Private_key.txt
*.pem
*.key
*.p12
*.jks
*.keystore

# Binary packages / local archives / database dumps
*.jar
*.war
*.class
*.zip
*.tar.gz
*.dump
*.backup
*.bak
!backend/.mvn/wrapper/maven-wrapper.jar

# Generated artifacts and GateJ-FREEZE evidence
artifacts/
backups/
freeze-evidence/
release/

# 发布清单与工具是源码；导出树仍只允许放在仓库外。
!/release/
/release/*
!/release/source-manifest.json
!/release/source-policy.md
!/scripts/release/
/scripts/release/*
!/scripts/release/release_source.py
!/scripts/release/verify_release_boundary.py
!/scripts/release/scan_release_secrets.py
!/scripts/release/tests/
/scripts/release/tests/*
!/scripts/release/tests/test_release_source.py
