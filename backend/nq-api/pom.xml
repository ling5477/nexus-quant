<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guidinglight.nexusquant</groupId>
        <artifactId>nexus-quant-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nq-api</artifactId>
    <name>nq-api</name>
    <description>HTTP API module for NexusQuant backend.</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-research</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-backtest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-eval</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-scheduler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            GateM-5A: 只读 adapter readiness status API 需要 AdapterReadinessService 与 readiness 模型。
            此前仅经 nq-scheduler 传递性可见；显式声明直接依赖，避免依赖传递性脆弱。仅编译期/运行期读取静态
            readiness 决策，不引入真实交易所、credential 或 LIVE 能力。
        -->
        <dependency>
            <groupId>com.guidinglight.nexusquant</groupId>
            <artifactId>nq-adapter-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.28</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
