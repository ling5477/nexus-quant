# NexusQuant 环境变量示例模板
# Why: 本文件是环境变量规范样板，后续新增配置必须先写到这里，再同步到本地 .env。
# 规则:
# 1) 每个配置项都必须带中文注释，说明用途、默认值和何时需要修改。
# 2) 非敏感配置必须固化默认值，避免运行时靠猜。
# 3) 敏感配置只保留占位提示，真实值只能写在本机 .env。
# 4) 同一轮运行态验收不得混用 dome 和 real。
# 5) 切换环境后必须重启 nq-app。

# 当前运行 profile，默认 local。
NQ_PROFILE=local

# 本地 PostgreSQL 镜像版本，默认 postgres:17.7。
NQ_DB_IMAGE=postgres:17.7

# 本地数据库名，默认 nexus_quant。
NQ_DB_NAME=nexus_quant

# 本地数据库用户名，默认 postgres。
NQ_DB_USER=postgres

# 本地数据库密码，默认 123456，仅用于本机开发。
NQ_DB_PASSWORD=123456

# 本地数据库端口，默认 15432。
NQ_DB_PORT=15432

# nq-app HTTP 监听端口，默认 8080。
NQ_APP_PORT=8080

# GateC 验收入口开关，默认 false；仅在本地验收时显式开启。
NQ_GATEC_VERIFY_ENABLED=false

# OKX 环境选择，默认 dome；可选 dome/real。
NQ_OKX_ENV=dome

# OKX 模拟盘 REST base URL，默认 https://www.okx.com。
NQ_OKX_DOME_BASE_URL=https://www.okx.com

# OKX 模拟盘 API Key，占位提示；请替换为本机本地凭证。
NQ_OKX_DOME_API_KEY=REPLACE_WITH_LOCAL_OKX_DOME_API_KEY

# OKX 模拟盘 API Secret，占位提示；请替换为本机本地凭证。
NQ_OKX_DOME_API_SECRET=REPLACE_WITH_LOCAL_OKX_DOME_API_SECRET

# OKX 模拟盘 API Passphrase，占位提示；请替换为本机本地凭证。
NQ_OKX_DOME_API_PASSPHRASE=REPLACE_WITH_LOCAL_OKX_DOME_API_PASSPHRASE

# OKX 实盘 REST base URL，默认 https://www.okx.com。
NQ_OKX_REAL_BASE_URL=https://www.okx.com

# OKX 实盘 API Key，占位提示；请替换为本机本地凭证。
NQ_OKX_REAL_API_KEY=REPLACE_WITH_LOCAL_OKX_REAL_API_KEY

# OKX 实盘 API Secret，占位提示；请替换为本机本地凭证。
NQ_OKX_REAL_API_SECRET=REPLACE_WITH_LOCAL_OKX_REAL_API_SECRET

# OKX 实盘 API Passphrase，占位提示；请替换为本机本地凭证。
NQ_OKX_REAL_API_PASSPHRASE=REPLACE_WITH_LOCAL_OKX_REAL_API_PASSPHRASE

# OKX REST 超时，默认 5000ms。
NQ_OKX_TIMEOUT_MS=5000

# OKX 私有 WS 开关，默认 false；仅在 WS 验收时显式开启。
NQ_OKX_WS_ENABLED=false

# OKX 模拟盘私有 WS 地址，默认使用官方模拟盘私有通道。
NQ_OKX_DOME_WS_URL=wss://wspap.okx.com:8443/ws/v5/private

# OKX 实盘私有 WS 地址，默认使用官方实盘私有通道。
NQ_OKX_REAL_WS_URL=wss://ws.okx.com:8443/ws/v5/private

# OKX WS 重连基础退避时间，默认 1000ms。
NQ_OKX_WS_RECONNECT_BASE_DELAY_MS=1000

# OKX WS 重连最大退避时间，默认 30000ms。
NQ_OKX_WS_RECONNECT_MAX_DELAY_MS=30000

# OKX WS 心跳周期，默认 20000ms。
NQ_OKX_WS_HEARTBEAT_INTERVAL_MS=20000

# OKX WS smoke 强制断连时间，默认 0 表示不启用。
NQ_OKX_WS_SMOKE_FORCE_RECONNECT_MS=0

# OKX WS 降级后单次受限 reconcile 的最大订单数，默认 100。
NQ_OKX_WS_DEGRADE_RECONCILE_LIMIT=100

# OKX WS 降级冷却时间，默认 15000ms。
NQ_OKX_WS_DEGRADE_COOLDOWN_MS=15000

# OKX WS 订阅连续失败阈值，默认 3；达到后触发受限 reconcile。
NQ_OKX_WS_DEGRADE_SUBSCRIBE_FAIL_THRESHOLD=3

# Binance 环境选择，默认 dome；可选 dome/real。
NQ_BINANCE_ENV=dome

# Binance 密钥类型，默认 hmac；Real 环境必须切到 ed25519。
NQ_BINANCE_KEY_TYPE=hmac

# Binance Testnet REST base URL，默认 https://testnet.binance.vision。
NQ_BINANCE_DOME_BASE_URL=https://testnet.binance.vision

# Binance Testnet API Key，占位提示；请替换为本机本地凭证。
NQ_BINANCE_DOME_API_KEY=REPLACE_WITH_LOCAL_BINANCE_DOME_API_KEY

# Binance Testnet API Secret，占位提示；默认用于 hmac。
NQ_BINANCE_DOME_API_SECRET=REPLACE_WITH_LOCAL_BINANCE_DOME_API_SECRET

# Binance Testnet 私钥内容，占位提示；仅在本机需要 inline private key 时填写。
NQ_BINANCE_DOME_PRIVATE_KEY=REPLACE_WITH_LOCAL_BINANCE_DOME_PRIVATE_KEY_IF_NEEDED

# Binance Testnet 私钥文件路径，占位提示；仅在本机需要文件私钥时填写。
NQ_BINANCE_DOME_PRIVATE_KEY_PATH=REPLACE_WITH_LOCAL_BINANCE_DOME_PRIVATE_KEY_PATH_IF_NEEDED

# Binance Real REST base URL，默认 https://api.binance.com。
NQ_BINANCE_REAL_BASE_URL=https://api.binance.com

# Binance Real API Key，占位提示；请替换为本机本地凭证。
NQ_BINANCE_REAL_API_KEY=REPLACE_WITH_LOCAL_BINANCE_REAL_API_KEY

# Binance Real API Secret，占位提示；仅在使用 hmac 时填写，ed25519 可留占位。
NQ_BINANCE_REAL_API_SECRET=REPLACE_WITH_LOCAL_BINANCE_REAL_API_SECRET_IF_USING_HMAC

# Binance Real 私钥内容，占位提示；仅在本机需要 inline ed25519 private key 时填写。
NQ_BINANCE_REAL_PRIVATE_KEY=REPLACE_WITH_LOCAL_BINANCE_REAL_PRIVATE_KEY_IF_USING_INLINE_PEM

# Binance Real 私钥文件路径，占位提示；Real 环境优先使用该路径加载 ed25519 私钥。
NQ_BINANCE_REAL_PRIVATE_KEY_PATH=REPLACE_WITH_LOCAL_BINANCE_REAL_PRIVATE_KEY_PATH

# Binance REST 超时，默认 3000ms。
NQ_BINANCE_TIMEOUT_MS=3000

# Binance exchangeInfo 刷新周期，默认 300000ms。
NQ_BINANCE_EXCHANGE_INFO_REFRESH_MS=300000

# Binance 私有 WS 开关，默认 false；仅在 WS 验收时显式开启。
NQ_BINANCE_WS_ENABLED=false

# Binance Testnet ws-api 地址，固定为官方 Testnet ws-api/v3。
NQ_BINANCE_DOME_WS_URL=wss://ws-api.testnet.binance.vision/ws-api/v3

# Binance Real ws-api 地址，固定为官方 Real ws-api/v3。
NQ_BINANCE_REAL_WS_URL=wss://ws-api.binance.com:443/ws-api/v3

# Binance WS 重连基础退避时间，默认 1000ms。
NQ_BINANCE_WS_RECONNECT_BASE_DELAY_MS=1000

# Binance WS 重连最大退避时间，默认 30000ms。
NQ_BINANCE_WS_RECONNECT_MAX_DELAY_MS=30000

# Binance WS 心跳周期，默认 20000ms。
NQ_BINANCE_WS_HEARTBEAT_INTERVAL_MS=20000

# Binance listenKey 刷新周期，默认 1800000ms。
NQ_BINANCE_LISTENKEY_REFRESH_MS=1800000

# Binance WS smoke 强制断连时间，默认 0 表示不启用。
NQ_BINANCE_WS_SMOKE_FORCE_RECONNECT_MS=0

# Binance WS 降级后单次受限 reconcile 的最大订单数，默认 100。
NQ_BINANCE_WS_DEGRADE_RECONCILE_LIMIT=100

# Binance WS 降级冷却时间，默认 15000ms。
NQ_BINANCE_WS_DEGRADE_COOLDOWN_MS=15000

# Binance WS 连续重连失败阈值，默认 2；达到后触发受限 reconcile。
NQ_BINANCE_WS_DEGRADE_RECONNECT_FAIL_THRESHOLD=2

# 环境切换速记:
# - OKX 模拟盘: NQ_OKX_ENV=dome
# - OKX 实盘: NQ_OKX_ENV=real
# - Binance Testnet: NQ_BINANCE_ENV=dome + NQ_BINANCE_KEY_TYPE=hmac
# - Binance 实盘: NQ_BINANCE_ENV=real + NQ_BINANCE_KEY_TYPE=ed25519
