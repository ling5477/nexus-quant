NQ_PROFILE=local
NQ_DB_IMAGE=postgres:17.7
NQ_DB_NAME=nexus_quant
NQ_DB_USER=postgres
NQ_DB_PASSWORD=123456
NQ_DB_PORT=15432
NQ_APP_PORT=8080
# GateC 验收入口显式开关（映射配置键 nq.gatec.verify.enabled）
NQ_GATEC_VERIFY_ENABLED=false

# OKX 运行环境：dome=模拟盘，real=真实盘
NQ_OKX_ENV=dome

# Dome（模拟盘）环境
NQ_OKX_DOME_BASE_URL=
NQ_OKX_DOME_API_KEY=
NQ_OKX_DOME_API_SECRET=
NQ_OKX_DOME_API_PASSPHRASE=

# Real（真实盘）环境
NQ_OKX_REAL_BASE_URL=
NQ_OKX_REAL_API_KEY=
NQ_OKX_REAL_API_SECRET=
NQ_OKX_REAL_API_PASSPHRASE=

# OKX 通用超时（毫秒）
NQ_OKX_TIMEOUT_MS=
NQ_OKX_WS_ENABLED=false
NQ_OKX_DOME_WS_URL=
NQ_OKX_REAL_WS_URL=
NQ_OKX_WS_RECONNECT_BASE_DELAY_MS=
NQ_OKX_WS_RECONNECT_MAX_DELAY_MS=
NQ_OKX_WS_HEARTBEAT_INTERVAL_MS=
NQ_OKX_WS_SMOKE_FORCE_RECONNECT_MS=
NQ_OKX_WS_DEGRADE_RECONCILE_LIMIT=
NQ_OKX_WS_DEGRADE_COOLDOWN_MS=
NQ_OKX_WS_DEGRADE_SUBSCRIBE_FAIL_THRESHOLD=

# Binance 运行环境：dome=测试/模拟环境，real=真实盘
NQ_BINANCE_ENV=dome

# Dome（测试/模拟）环境
NQ_BINANCE_DOME_BASE_URL=
NQ_BINANCE_DOME_API_KEY=
NQ_BINANCE_DOME_API_SECRET=

# Real（真实盘）环境
NQ_BINANCE_REAL_BASE_URL=
NQ_BINANCE_REAL_API_KEY=
NQ_BINANCE_REAL_API_SECRET=

# Binance 通用超时与 exchangeInfo 刷新窗口（毫秒）
NQ_BINANCE_TIMEOUT_MS=
NQ_BINANCE_EXCHANGE_INFO_REFRESH_MS=

# 测试/生产环境占位变量（当前 Gate A 不启用）
# NQ_TEST_DB_URL=jdbc:postgresql://localhost:5432/nexus_quant_test
# NQ_TEST_DB_USER=postgres
# NQ_TEST_DB_PASSWORD=123456
# NQ_PROD_DB_URL=jdbc:postgresql://db-prod:5432/nexus_quant
# NQ_PROD_DB_USER=postgres
# NQ_PROD_DB_PASSWORD=change_me
