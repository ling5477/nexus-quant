# NexusQuant 环境变量示例模板
# Why: 本文件是环境变量规范样板，后续新增配置必须先写到这里，再同步到本地 .env。
# 规则:
# 1) 每个配置项都必须带中文注释，说明用途、默认值和何时需要修改。
# 2) 非敏感配置可保留本地默认值；敏感值、交易所 endpoint 和私钥路径只允许统一 placeholder。
# 3) 允许的 placeholder 仅为 PLACEHOLDER_ONLY / DO_NOT_COMMIT_REAL_VALUE / REPLACE_WITH_LOCAL_PLACEHOLDER。
# 4) 本文件不得写入真实 API key、secret、token、cookie、passphrase、private key 或真实交易所 endpoint。
# 5) CI/test/paper 默认 no-outbound；切换环境后必须重启 nq-app。

# 当前运行 profile，默认 local；CI 可使用 ci，Paper 边界可使用 paper。
NQ_PROFILE=local

# 5B-ENV 安全边界：CI/test/paper 默认 no-outbound，LIVE/AI/DH/real provider/real exchange 默认关闭。
NQ_NO_OUTBOUND=true
NQ_LIVE_ENABLED=false
NQ_AI_ENABLED=false
NQ_DH_RUNTIME_ENABLED=false
NQ_REAL_PROVIDER_ENABLED=false
NQ_REAL_CLIENT_ENABLED=false
NQ_REAL_EXCHANGE_ENABLED=false

# 本地 PostgreSQL 镜像版本，默认 postgres:17.7。
NQ_DB_IMAGE=postgres:17.7

# 本地数据库名，默认 nexus_quant。
NQ_DB_NAME=nexus_quant

# 本地数据库用户名，默认 postgres。
NQ_DB_USER=postgres

# 本地数据库密码 placeholder；真实本机值只能写入未提交的 .env。
NQ_DB_PASSWORD=DO_NOT_COMMIT_REAL_VALUE

# 本地数据库端口，默认 5432；与 docker-compose 和 local profile 保持一致。
NQ_DB_PORT=5432

# nq-app HTTP 监听端口，默认 18888。
NQ_APP_PORT=18888

# GateD 验收入口开关，默认 false；仅在本地验收时显式开启。
NQ_GATED_VERIFY_ENABLED=false

# OKX 环境选择，默认 dome；real 只能在后续单独任务和安全审查后显式启用。
NQ_OKX_ENV=dome

# OKX REST / WS endpoint placeholder；CI/test 不使用真实 endpoint，真实 URL 不得写入本文件。
NQ_OKX_BASE_URL=PLACEHOLDER_ONLY
NQ_OKX_DOME_BASE_URL=PLACEHOLDER_ONLY
NQ_OKX_REAL_BASE_URL=PLACEHOLDER_ONLY
NQ_OKX_WS_URL=PLACEHOLDER_ONLY
NQ_OKX_DOME_WS_URL=PLACEHOLDER_ONLY
NQ_OKX_REAL_WS_URL=PLACEHOLDER_ONLY

# OKX credential placeholder；真实值只能写入本机未提交 .env，不得进入 CI/test。
NQ_OKX_API_KEY=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_OKX_API_SECRET=DO_NOT_COMMIT_REAL_VALUE
NQ_OKX_API_PASSPHRASE=DO_NOT_COMMIT_REAL_VALUE
NQ_OKX_DOME_API_KEY=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_OKX_DOME_API_SECRET=DO_NOT_COMMIT_REAL_VALUE
NQ_OKX_DOME_API_PASSPHRASE=DO_NOT_COMMIT_REAL_VALUE
NQ_OKX_REAL_API_KEY=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_OKX_REAL_API_SECRET=DO_NOT_COMMIT_REAL_VALUE
NQ_OKX_REAL_API_PASSPHRASE=DO_NOT_COMMIT_REAL_VALUE

# OKX REST 超时，默认 5000ms。
NQ_OKX_TIMEOUT_MS=5000

# OKX 私有 WS 开关，默认 false；5B-ENV 不启动 WS smoke。
NQ_OKX_WS_ENABLED=false
NQ_OKX_WS_RECONNECT_BASE_DELAY_MS=1000
NQ_OKX_WS_RECONNECT_MAX_DELAY_MS=30000
NQ_OKX_WS_HEARTBEAT_INTERVAL_MS=20000
NQ_OKX_WS_SMOKE_FORCE_RECONNECT_MS=0
NQ_OKX_WS_DEGRADE_RECONCILE_LIMIT=100
NQ_OKX_WS_DEGRADE_COOLDOWN_MS=15000
NQ_OKX_WS_DEGRADE_SUBSCRIBE_FAIL_THRESHOLD=3

# Binance 环境选择，默认 dome；real 只能在后续单独任务和安全审查后显式启用。
NQ_BINANCE_ENV=dome

# Binance 密钥类型，默认 hmac；Real 环境不得在本文件内启用真实私钥。
NQ_BINANCE_KEY_TYPE=hmac

# Binance REST / WS endpoint placeholder；CI/test 不使用真实 endpoint，真实 URL 不得写入本文件。
NQ_BINANCE_DOME_BASE_URL=PLACEHOLDER_ONLY
NQ_BINANCE_REAL_BASE_URL=PLACEHOLDER_ONLY
NQ_BINANCE_DOME_WS_URL=PLACEHOLDER_ONLY
NQ_BINANCE_REAL_WS_URL=PLACEHOLDER_ONLY

# Binance credential placeholder；真实值只能写入本机未提交 .env，不得进入 CI/test。
NQ_BINANCE_DOME_API_KEY=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_BINANCE_DOME_API_SECRET=DO_NOT_COMMIT_REAL_VALUE
NQ_BINANCE_DOME_PRIVATE_KEY=DO_NOT_COMMIT_REAL_VALUE
NQ_BINANCE_DOME_PRIVATE_KEY_PATH=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_BINANCE_REAL_API_KEY=REPLACE_WITH_LOCAL_PLACEHOLDER
NQ_BINANCE_REAL_API_SECRET=DO_NOT_COMMIT_REAL_VALUE
NQ_BINANCE_REAL_PRIVATE_KEY=DO_NOT_COMMIT_REAL_VALUE
NQ_BINANCE_REAL_PRIVATE_KEY_PATH=REPLACE_WITH_LOCAL_PLACEHOLDER

# Binance REST / WS 运行参数；5B-ENV 不启动真实 WS smoke。
NQ_BINANCE_TIMEOUT_MS=3000
NQ_BINANCE_EXCHANGE_INFO_REFRESH_MS=300000
NQ_BINANCE_SIGNED_TIMESTAMP_OFFSET_MS=0
NQ_BINANCE_WS_ENABLED=false
NQ_BINANCE_WS_RECONNECT_BASE_DELAY_MS=1000
NQ_BINANCE_WS_RECONNECT_MAX_DELAY_MS=30000
NQ_BINANCE_WS_HEARTBEAT_INTERVAL_MS=20000
NQ_BINANCE_LISTENKEY_REFRESH_MS=1800000
NQ_BINANCE_WS_SMOKE_FORCE_RECONNECT_MS=0
NQ_BINANCE_WS_DEGRADE_RECONCILE_LIMIT=100
NQ_BINANCE_WS_DEGRADE_COOLDOWN_MS=15000
NQ_BINANCE_WS_DEGRADE_RECONNECT_FAIL_THRESHOLD=2

# 环境切换速记:
# - CI/test/paper: no-outbound=true + endpoint placeholder + credential placeholder。
# - OKX/Binance real: 本文件只记录 placeholder；真实 provider / RealClient / real exchange adapter 仍未实现。
