{
  "schemaVersion": "2.0.0",
  "authoritySchema": 3,
  "authority": {
    "requiredFields": [
      "authority_schema",
      "last_frozen_gate",
      "last_frozen_gate_status",
      "last_frozen_gate_tag",
      "last_frozen_gate_commit",
      "active_gate",
      "active_gate_status",
      "accepted_batch",
      "accepted_batch_status",
      "accepted_batch_implementation_commit",
      "accepted_batch_acceptance_head",
      "accepted_batch_ci_run",
      "work_batch",
      "work_batch_status",
      "work_batch_commit",
      "work_batch_ci_run",
      "next_action",
      "production_soak",
      "kill_switch",
      "live",
      "shadow_trading",
      "ai",
      "dh_runtime",
      "integration_runtime",
      "real_provider",
      "private_trading"
    ],
    "activeGateStatuses": [
      "IN_PROGRESS|NOT_FROZEN",
      "FROZEN|ACCEPTED|TAGGED"
    ],
    "acceptedBatchStatuses": [
      "ACCEPTED|CI_GREEN",
      "NONE"
    ],
    "workBatchStatuses": [
      "NOT_STARTED",
      "IMPLEMENTED|SELF_REVIEWED",
      "IMPLEMENTED|PENDING_REVIEW",
      "REVIEW_ACCEPTED|READY_TO_COMMIT",
      "COMMITTED|CI_PENDING",
      "ACCEPTED|CI_GREEN",
      "CI_FAILED",
      "BLOCKED",
      "FROZEN|ACCEPTED|TAGGED"
    ],
    "allowedNextActionTypesByStatus": {
      "NOT_STARTED": ["IMPLEMENTATION", "AUDIT", "PLAN"],
      "IMPLEMENTED|SELF_REVIEWED": ["COMMIT", "REVIEW"],
      "IMPLEMENTED|PENDING_REVIEW": ["REVIEW"],
      "REVIEW_ACCEPTED|READY_TO_COMMIT": ["COMMIT"],
      "COMMITTED|CI_PENDING": ["CI"],
      "ACCEPTED|CI_GREEN": ["NONE", "PLAN", "IMPLEMENTATION", "AUDIT", "FREEZE", "RELEASE"],
      "CI_FAILED": ["FIX"],
      "BLOCKED": ["UNBLOCK"],
      "FROZEN|ACCEPTED|TAGGED": ["NONE", "PLAN", "IMPLEMENTATION", "AUDIT"]
    },
    "workStatusFieldPolicies": {
      "NOT_STARTED": { "commitPattern": "^NONE$", "ciPattern": "^(NOT_RUN|NONE)$" },
      "IMPLEMENTED|SELF_REVIEWED": { "commitPattern": "^NONE$", "ciPattern": "^(NOT_RUN|NONE)$" },
      "IMPLEMENTED|PENDING_REVIEW": { "commitPattern": "^NONE$", "ciPattern": "^(NOT_RUN|NONE)$" },
      "REVIEW_ACCEPTED|READY_TO_COMMIT": { "commitPattern": "^NONE$", "ciPattern": "^(NOT_RUN|NONE)$" },
      "COMMITTED|CI_PENDING": { "commitPattern": "^[0-9a-f]{40}$", "ciPattern": "^(PENDING|[0-9]+)$" },
      "ACCEPTED|CI_GREEN": { "commitPattern": "^[0-9a-f]{40}$", "ciPattern": "^[0-9]+$" },
      "CI_FAILED": { "commitPattern": "^[0-9a-f]{40}$", "ciPattern": "^([0-9]+|FAILED)$" },
      "BLOCKED": { "commitPattern": "^(NONE|[0-9a-f]{40})$", "ciPattern": "^(NOT_RUN|NONE|PENDING|[0-9]+)$" },
      "FROZEN|ACCEPTED|TAGGED": { "commitPattern": "^[0-9a-f]{40}$", "ciPattern": "^[0-9]+$" }
    },
    "nextActionTypes": [
      { "name": "AUDIT", "pattern": "(?i)(^|-)FULL-REPOSITORY-AUDIT(?:-|$)|(^|-)REPOSITORY-AUDIT(?:-|$)" },
      { "name": "FREEZE", "pattern": "(?i)(^|-)FREEZE(?:-|$)" },
      { "name": "RELEASE", "pattern": "(?i)(^|-)RELEASE(?:-|$)|(^|-)TAG(?:-|$)" },
      { "name": "CI", "pattern": "(?i)(^|-)CI(?:-|$)|(^|-)WAIT-CI(?:-|$)" },
      { "name": "REVIEW", "pattern": "(?i)(^|-)REVIEW(?:-|$)" },
      { "name": "FIX", "pattern": "(?i)(^|-)(FIX|REMEDIATION)(?:-|$)" },
      { "name": "COMMIT", "pattern": "(?i)(^|-)COMMIT(?:-|$)" },
      { "name": "UNBLOCK", "pattern": "(?i)(^|-)(UNBLOCK|RESUME)(?:-|$)" },
      { "name": "PLAN", "pattern": "(?i)(^|-)PLAN(?:-|$)" },
      { "name": "IMPLEMENTATION", "pattern": "(?i)(^|-)IMPLEMENTATION(?:-|$)" },
      { "name": "NONE", "pattern": "^NONE$" }
    ],
    "safetyProfileRequiredFields": [
      "production_soak",
      "live",
      "kill_switch",
      "shadow_trading",
      "ai",
      "dh_runtime",
      "integration_runtime",
      "real_provider",
      "private_trading"
    ],
    "safetyProfiles": {
      "default": {
        "production_soak": ["COMPLETED"],
        "live": ["DISABLED"],
        "kill_switch": ["ENGAGED"],
        "shadow_trading": ["NOT_ENABLED"],
        "ai": ["NOT_STARTED"],
        "dh_runtime": ["NOT_INTEGRATED"],
        "integration_runtime": ["NOT_STARTED"],
        "real_provider": ["NOT_IMPLEMENTED"],
        "private_trading": ["NOT_IMPLEMENTED"]
      },
      "byActiveGate": {
        "GateAUDIT": {
          "production_soak": ["COMPLETED"],
          "live": ["DISABLED"],
          "kill_switch": ["ENGAGED"],
          "shadow_trading": ["NOT_ENABLED"],
          "ai": ["NOT_STARTED"],
          "dh_runtime": ["NOT_INTEGRATED"],
          "integration_runtime": ["NOT_STARTED"],
          "real_provider": ["NOT_IMPLEMENTED"],
          "private_trading": ["NOT_IMPLEMENTED"]
        }
      }
    }
  },
  "lifecycles": {
    "ordinary": {
      "transitions": [
        ["NOT_STARTED", "IMPLEMENTED|SELF_REVIEWED"],
        ["IMPLEMENTED|SELF_REVIEWED", "COMMITTED|CI_PENDING"],
        ["COMMITTED|CI_PENDING", "ACCEPTED|CI_GREEN"],
        ["COMMITTED|CI_PENDING", "CI_FAILED"],
        ["CI_FAILED", "IMPLEMENTED|SELF_REVIEWED"],
        ["NOT_STARTED", "BLOCKED"],
        ["BLOCKED", "NOT_STARTED"]
      ]
    },
    "highRisk": {
      "transitions": [
        ["NOT_STARTED", "IMPLEMENTED|PENDING_REVIEW"],
        ["IMPLEMENTED|PENDING_REVIEW", "REVIEW_ACCEPTED|READY_TO_COMMIT"],
        ["REVIEW_ACCEPTED|READY_TO_COMMIT", "COMMITTED|CI_PENDING"],
        ["COMMITTED|CI_PENDING", "ACCEPTED|CI_GREEN"],
        ["COMMITTED|CI_PENDING", "CI_FAILED"],
        ["CI_FAILED", "IMPLEMENTED|PENDING_REVIEW"],
        ["NOT_STARTED", "BLOCKED"],
        ["BLOCKED", "NOT_STARTED"]
      ]
    },
    "ciFailed": {
      "transitions": [
        ["COMMITTED|CI_PENDING", "CI_FAILED"],
        ["CI_FAILED", "IMPLEMENTED|SELF_REVIEWED"],
        ["CI_FAILED", "IMPLEMENTED|PENDING_REVIEW"]
      ]
    },
    "blocked": {
      "transitions": [
        ["NOT_STARTED", "BLOCKED"],
        ["IMPLEMENTED|SELF_REVIEWED", "BLOCKED"],
        ["IMPLEMENTED|PENDING_REVIEW", "BLOCKED"],
        ["BLOCKED", "NOT_STARTED"]
      ]
    },
    "freeze": {
      "transitions": [
        ["ACCEPTED|CI_GREEN", "FROZEN|ACCEPTED|TAGGED"]
      ]
    },
    "release": {
      "transitions": [
        ["ACCEPTED|CI_GREEN", "FROZEN|ACCEPTED|TAGGED"]
      ]
    },
    "soak": {
      "transitions": [
        ["NOT_STARTED", "IMPLEMENTED|PENDING_REVIEW"],
        ["IMPLEMENTED|PENDING_REVIEW", "REVIEW_ACCEPTED|READY_TO_COMMIT"],
        ["REVIEW_ACCEPTED|READY_TO_COMMIT", "COMMITTED|CI_PENDING"],
        ["COMMITTED|CI_PENDING", "ACCEPTED|CI_GREEN"],
        ["COMMITTED|CI_PENDING", "CI_FAILED"],
        ["CI_FAILED", "IMPLEMENTED|PENDING_REVIEW"],
        ["NOT_STARTED", "BLOCKED"]
      ]
    }
  },
  "evidence": {
    "safeExtensions": [".md", ".json"],
    "currentPathPattern": "^docs/current/evidence/[a-z0-9-]+/(?:README\\.md|[A-Z0-9][A-Z0-9._-]*\\.attempt-[0-9]{2}\\.md)$",
    "archivePathPattern": "^source/task-evidence/(?:README\\.md|[A-Z0-9][A-Z0-9._-]*\\.attempt-[0-9]{2}\\.md|[A-Z0-9][A-Z0-9._-]*\\.manifest\\.json)$",
    "archiveRoot": "source/task-evidence/",
    "attemptPattern": "^[A-Z0-9][A-Z0-9._-]*\\.attempt-[0-9]{2}\\.md$",
    "indexFileName": "README.md",
    "minimumIndexNonWhitespaceCharacters": 10,
    "minimumAttemptNonWhitespaceCharacters": 80,
    "placeholderPattern": "(?i)^#?\\s*(TODO|TBD|PLACEHOLDER)\\s*$",
    "rejectSymlinks": true,
    "nonRole": true
  },
  "release": {
    "remoteName": "origin",
    "expectedBranch": "dev",
    "workflowName": "NQ CI Baseline",
    "tagPattern": "^nq-gate[a-z0-9]+-freeze$",
    "requireAnnotatedTag": true,
    "requireRemoteTag": true,
    "requireExactHeadCi": true
  },
  "hardBlockers": [
    "CURRENT_AUTHORITY_CONFLICT",
    "AUTHORITY_SCHEMA_INVALID",
    "SAFETY_PROFILE_VIOLATION",
    "ARCHIVE_MANIFEST_INCOMPLETE",
    "ARCHIVE_ALLOWLIST_INCOMPLETE",
    "GATE_RELEASE_INVALID"
  ]
}
