{
  "schemaVersion": "1.0.0",
  "legacyThroughGate": "gate-t",
  "mandatoryRoles": [
    "archive-entry",
    "freeze-closeout",
    "freeze-readiness",
    "plan-or-reconstructed-baseline",
    "batch-evidence-matrix",
    "testing-evidence",
