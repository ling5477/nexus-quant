    "freeze-readiness": [
      "FREEZE_READINESS(_REVIEW)?\\.md$",
      "FREEZE_REVIEW\\.md$"
    ],
    "plan-or-reconstructed-baseline": [
      "(^|/)[^/]*PLAN\\.md$",
      "IMPLEMENTATION_BASELINE\\.md$",
      "RECONSTRUCTED_BASELINE\\.md$"
    ],
    "batch-evidence-matrix": [
      "BATCH_[0-9_]+_EVIDENCE_MATRIX\\.md$",
