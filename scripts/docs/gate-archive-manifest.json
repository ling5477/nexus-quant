{
  "schemaVersion": "2.0.0",
  "legacyThroughGate": "gate-t",
  "mandatoryRoles": [
    "archive-entry",
    "freeze-closeout",
    "freeze-readiness",
    "plan-or-reconstructed-baseline",
    "batch-evidence-matrix",
    "testing-evidence",
    "boundary-statement",
    "known-limitations"
  ],
  "defaultStrictPolicy": {
    "conditionalRoles": [
      "backend-db-evidence",
      "api-evidence",
      "frontend-evidence",
      "python-boundary-evidence",
      "runtime-scheduling-evidence"
    ],
    "allowPreTagArchiveState": true
  },
  "acceptedAliases": {
    "archive-entry": ["(^|/)README\\.md$"],
    "freeze-closeout": ["FREEZE_CLOSEOUT\\.md$", "RELEASE_TAG_AND_ARCHIVE\\.md$", "FINAL_CLOSEOUT\\.md$"],
    "freeze-readiness": ["FREEZE_READINESS(_REVIEW)?\\.md$", "FREEZE_REVIEW\\.md$"],
    "plan-or-reconstructed-baseline": ["(^|/)[^/]*PLAN\\.md$", "IMPLEMENTATION_BASELINE\\.md$", "RECONSTRUCTED_BASELINE\\.md$"],
    "batch-evidence-matrix": ["BATCH_[0-9_]+_EVIDENCE_MATRIX\\.md$", "EVIDENCE_MATRIX\\.md$"],
    "testing-evidence": ["TESTING_EVIDENCE_SUMMARY\\.md$", "TESTING_AND_CI_SUMMARY\\.md$", "TEST.*SUMMARY\\.md$", "CI_EVIDENCE.*\\.md$"],
    "boundary-statement": ["BOUNDARY_STATEMENT\\.md$"],
    "known-limitations": ["KNOWN_LIMITATIONS(_AND_RESIDUALS)?\\.md$", "LIMITATIONS.*RESIDUALS\\.md$"],
    "backend-db-evidence": ["BACKEND.*EVIDENCE.*\\.md$", "DATABASE_EVIDENCE\\.md$", "DB_MIGRATION_EVIDENCE.*\\.md$"],
    "api-evidence": ["API.*EVIDENCE.*\\.md$"],
    "frontend-evidence": ["FRONTEND.*EVIDENCE.*\\.md$"],
    "python-boundary-evidence": ["PYTHON.*(EVIDENCE|BOUNDARY).*\\.md$"],
    "runtime-scheduling-evidence": ["RUNTIME.*(EVIDENCE|BOUNDARY|READINESS|SUMMARY).*\\.md$", "SCHEDULING.*(EVIDENCE|BOUNDARY|READINESS|SUMMARY).*\\.md$"],
    "deployment-evidence": ["DEPLOYMENT_EVIDENCE_SUMMARY\\.md$"],
    "live-pilot-evidence": ["MINIMAL_LIVE_PILOT_EVIDENCE_SUMMARY\\.md$"],
    "live-session-work-order": ["GATEY_1_LIVE_SESSION_DATA_MODEL_WORK_ORDER\\.md$"],
    "micro-live-work-order": ["GATEY_6_EXPLICIT_MICRO_LIVE_AUTHORIZATION_WORK_ORDER\\.md$"]
  },
  "historicalProfiles": {
    "gate-u": {
      "conditionalRoles": ["backend-db-evidence", "api-evidence", "frontend-evidence", "python-boundary-evidence", "runtime-scheduling-evidence"],
      "allowPreTagArchiveState": true
    },
    "gate-v": {
      "conditionalRoles": ["backend-db-evidence", "api-evidence", "frontend-evidence", "runtime-scheduling-evidence"],
      "allowPreTagArchiveState": true
    },
    "gate-w": {
      "conditionalRoles": ["backend-db-evidence", "api-evidence", "frontend-evidence", "runtime-scheduling-evidence"],
      "allowPreTagArchiveState": true
    },
    "gate-x": {
      "conditionalRoles": ["backend-db-evidence", "api-evidence", "frontend-evidence", "runtime-scheduling-evidence"],
      "allowPreTagArchiveState": true
    },
    "gate-y": {
      "conditionalRoles": [
        "backend-db-evidence",
        "api-evidence",
        "frontend-evidence",
        "runtime-scheduling-evidence",
        "deployment-evidence",
        "live-pilot-evidence",
        "live-session-work-order",
        "micro-live-work-order"
      ],
      "allowPreTagArchiveState": true
    }
  },
  "warningPolicies": {
    "legacyManifestGap": "warning",
    "historicalSourceBrokenLink": "warning",
    "evidenceLedgerBrokenLink": "warning",
    "preTagArchiveStateAfterTag": "warning"
  },
  "roleBodyPolicy": {
    "minimumNonEmptyLines": 8,
    "minimumIndependentCharacters": 160
  }
}
