    "boundary-statement": [
      "BOUNDARY_STATEMENT\\.md$"
    ],
    "known-limitations": [
      "KNOWN_LIMITATIONS(_AND_RESIDUALS)?\\.md$",
      "LIMITATIONS.*RESIDUALS\\.md$"
    ],
    "backend-db-evidence": [
      "BACKEND.*EVIDENCE.*\\.md$",
      "DATABASE_EVIDENCE\\.md$",
      "DB_MIGRATION_EVIDENCE.*\\.md$"
    ],
    "api-evidence": [
      "API.*EVIDENCE.*\\.md$"
    ],
    "frontend-evidence": [
      "FRONTEND.*EVIDENCE.*\\.md$"
    ],
    "python-boundary-evidence": [
      "PYTHON.*(EVIDENCE|BOUNDARY).*\\.md$"
    ],
    "runtime-scheduling-evidence": [
      "RUNTIME.*(EVIDENCE|BOUNDARY|READINESS|SUMMARY).*\\.md$",
      "SCHEDULING.*(EVIDENCE|BOUNDARY|READINESS|SUMMARY).*\\.md$"
    ]
  },
