VITE_APP_TITLE=NexusQuant Console
VITE_APP_ENV_LABEL=LOCAL
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:18888
# 仅控制前端 SIM 入口；生产构建默认保留，开发模式默认关闭，不能代替服务端权限与能力判断。
VITE_STRATEGY_SIM_ENABLED=true
VITE_CONTINUOUS_SIM_ENABLED=true
E2E_BASE_URL=http://127.0.0.1:5179
E2E_USERNAME=admin
E2E_PASSWORD=CHANGE_ME_E2E_PASSWORD
