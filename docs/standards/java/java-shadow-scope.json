  ],
  "production_source_roots": [
    "backend"
  ],
  "production_source_marker": "/src/main/java/",
  "test_source_marker": "/src/test/java/",
  "scanner_mode": "JAVA_LEXICAL_STRUCTURE_AWARE",
  "time_restricted_prefixes": [
    "backend/nq-api/src/main/java/",
    "backend/nq-backtest/src/main/java/",
    "backend/nq-core/src/main/java/",
    "backend/nq-eval/src/main/java/",
    "backend/nq-ledger/src/main/java/",
    "backend/nq-research/src/main/java/",
    "backend/nq-risk/src/main/java/",
    "backend/nq-scheduler/src/main/java/"
  ],
  "infrastructure_time_boundary_prefixes": [
    "backend/nq-app/src/main/java/",
    "backend/nq-infra/src/main/java/",
    "backend/nq-adapter-api/src/main/java/",
    "backend/nq-adapter-binance/src/main/java/",
    "backend/nq-adapter-okx/src/main/java/",
    "backend/nq-observability/src/main/java/"
