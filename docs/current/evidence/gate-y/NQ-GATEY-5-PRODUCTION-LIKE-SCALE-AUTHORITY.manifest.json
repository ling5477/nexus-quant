      "growthMultiplierBps": 10000,
      "stressMultiplierBps": 10000,
      "rounding": "TARGET_IS_THE_REVIEWED_ABSOLUTE_CAPACITY_CEILING",
      "semantics": "multipliers are explicit 1.0 because headroom is embedded in the absolute ceiling"
