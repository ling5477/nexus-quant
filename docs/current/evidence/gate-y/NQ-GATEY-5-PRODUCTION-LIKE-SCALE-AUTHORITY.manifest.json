      "expectedBehavior": "conflicting migration lock waits and fails closed at lock_timeout"
    },
    {
      "name": "MULTIPLE_CONCURRENT_WRITERS",
      "scenarioClass": "FAULT_INJECTION",
      "transactionAgeSeconds": 30,
      "heldLock": "ROW_EXCLUSIVE",
      "affectedRelations": ["orders", "exchange_accounts", "strategy_release_admission_state"],
      "expectedBehavior": "no partial V39 schema; retry only after blockers are released"
    },
    {
      "name": "TRANSACTION_AGE_LIMIT",
      "scenarioClass": "LIMIT",
      "transactionAgeSeconds": 30,
