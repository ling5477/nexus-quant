    {
      "name": "NO_COMPETITION",
      "scenarioClass": "EXPECTED",
      "transactionAgeSeconds": 0,
      "heldLock": "NONE",
      "affectedRelations": [],
      "expectedBehavior": "V39 completes inside the measured bounded window"
    },
    {
      "name": "LONG_READ_TRANSACTION",
      "scenarioClass": "FAULT_INJECTION",
      "transactionAgeSeconds": 120,
      "heldLock": "ACCESS_SHARE",
      "affectedRelations": ["users", "orders", "strategy_release_admission_state"],
      "expectedBehavior": "measure non-blocking or blocking interaction without assuming either outcome"
