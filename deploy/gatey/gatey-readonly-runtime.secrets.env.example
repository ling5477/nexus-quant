# GateY root-only secret environment template.
# Install as /etc/nexus-quant/gatey-readonly-qualification/secrets.env.
# Required ownership: root:root, mode 0600. The service user must not read or write this file;
# systemd reads it before dropping privileges. Never commit the real secrets.env.

NQ_GATEY_QUALIFICATION_DB_PASSWORD=REPLACE_WITH_LOCAL
NQ_SECURITY_SECRET=REPLACE_WITH_LOCAL
NQ_ACCOUNT_CREDENTIALS_MASTER_KEY=REPLACE_WITH_LOCAL
