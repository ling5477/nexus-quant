# GateY read-only qualification runtime environment template.
# Install as /etc/nexus-quant/gatey-readonly-qualification/runtime.env.
# Required ownership: root:nq-gatey-readonly, mode 0640; service user must not write it.
# Replace placeholders locally on the server. Never commit the real runtime.env.

SPRING_PROFILES_ACTIVE=gatey-readonly-qualification
NQ_APP_BIND_ADDRESS=127.0.0.1
NQ_APP_PORT=18890
NQ_GATEY_MANAGEMENT_ADDRESS=127.0.0.1
NQ_GATEY_MANAGEMENT_PORT=18890

NQ_GATEY_RELEASE_ID=REPLACE_WITH_EXACT_COMMIT
NQ_GATEY_SOURCE_COMMIT=REPLACE_WITH_EXACT_COMMIT
NQ_GATEY_RELEASE_MANIFEST_SHA256=REPLACE_WITH_LOCAL

NQ_GATEY_QUALIFICATION_DB_URL=jdbc:postgresql://127.0.0.1:55432/nexus_quant
NQ_GATEY_QUALIFICATION_DB_USER=REPLACE_WITH_LOCAL
NQ_GATEY_DATABASE_TARGET_ID=gatey-production-control-plane
NQ_GATEY_DATABASE_CREDENTIAL_REFERENCE=gatey-readonly-qualification-db

NQ_LIVE_ENABLED=false
NQ_TRADING_COMPONENTS_ENABLED=false
NQ_RUNTIME_PROVIDER_OBSERVATION_ENABLED=true
NQ_RUNTIME_PROVIDER_OBSERVATION_ORDER_SUBMISSION_ENABLED=false
NQ_RUNTIME_PROVIDER_OBSERVATION_CANCEL_ENABLED=false
NQ_RUNTIME_PROVIDER_OBSERVATION_TRANSFER_ENABLED=false
NQ_RUNTIME_PROVIDER_OBSERVATION_WITHDRAW_ENABLED=false
NQ_GATEY_EXPECTED_KILL_SWITCH=ENGAGED
NQ_AUTH_BOOTSTRAP_ADMIN_ENABLED=false

NQ_SECURITY_ISSUER=nexus-quant-gatey-readonly
NQ_SECURITY_ACCESS_TOKEN_TTL=PT30M

NQ_ACCOUNT_CREDENTIALS_KEY_VERSION=1
NQ_ACCOUNT_CREDENTIALS_VERIFICATION_MODE=STRUCTURAL

# Non-secret exact pilot authority. Resolve these from accepted server facts; never use latest/current/HEAD.
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_MINIMAL_LIVE_PILOT_STRATEGY_RELEASE_ID=REPLACE_WITH_EXACT_ACCEPTED_PUBLISH_RECORD_ID
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_MINIMAL_LIVE_PILOT_RISK_LIMIT_SET_ID=REPLACE_WITH_EXACT_ACCEPTED_RISK_LIMIT_SET_UUID
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_INSTRUMENT_METADATA_DIGEST=REPLACE_WITH_SHA256
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_INSTRUMENT_SOURCE_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_INSTRUMENT_SOURCE_SCHEMA_VERSION=REPLACE_WITH_EXACT_SCHEMA
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_INSTRUMENT_MAXIMUM_AGE_MS=REPLACE_WITH_POSITIVE_INTEGER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_SCHEDULE_DIGEST=REPLACE_WITH_SHA256
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_TIER=REPLACE_WITH_EXACT_TIER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_EVIDENCE_CLASS=OBSERVED_PRIVATE
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_SOURCE_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_SOURCE_SCHEMA_VERSION=REPLACE_WITH_EXACT_SCHEMA
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_FEE_MAXIMUM_AGE_MS=REPLACE_WITH_POSITIVE_INTEGER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_BALANCE_SOURCE_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_BALANCE_SOURCE_SCHEMA_VERSION=REPLACE_WITH_EXACT_SCHEMA
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_BALANCE_MAXIMUM_AGE_MS=REPLACE_WITH_POSITIVE_INTEGER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_CLOCK_SOURCE_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_CLOCK_SOURCE_SCHEMA_VERSION=REPLACE_WITH_EXACT_SCHEMA
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_CLOCK_MAXIMUM_AGE_MS=REPLACE_WITH_POSITIVE_INTEGER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_SIGNED_TIMESTAMP_SOURCE=REPLACE_WITH_EXACT_SOURCE
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_MAXIMUM_TOLERATED_SKEW_MS=REPLACE_WITH_NON_NEGATIVE_INTEGER
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_ENDPOINT_POLICY_VERSION=REPLACE_WITH_EXACT_VERSION
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_ENDPOINT_POLICY_DIGEST=REPLACE_WITH_SHA256
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_PROVIDER_CONTRACT_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_PROVIDER_ARTIFACT_DIGEST=REPLACE_WITH_SHA256
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_WORKER_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
NQ_LIVE_CONTROL_PILOT_MATERIALIZATION_WORKER_RELEASE_DIGEST=REPLACE_WITH_SHA256
