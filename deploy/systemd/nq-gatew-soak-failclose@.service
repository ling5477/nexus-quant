[Unit]
Description=NexusQuant GateW independent fail-close finalizer (%i)
Documentation=file:/opt/nexus-quant/current/release-manifest.json
After=nq-gatew-soak@%i.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nexus-quant
Environment=NQ_GATEW_RELEASE_ROOT=/opt/nexus-quant/current
EnvironmentFile=/var/lib/nexus-quant/gatew-soak/%i/control/failclose.env
ExecStart=/usr/bin/pwsh -NoProfile -File ${NQ_GATEW_RELEASE_ROOT}/bin/gatew-okx-readonly-soak-failclose.ps1 -Action finalize -RunId %i
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=10s
RuntimeDirectory=nexus-quant/gatew-soak-failclose/%i
RuntimeDirectoryMode=0700
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
PrivateNetwork=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/nexus-quant/releases
ReadWritePaths=/var/lib/nexus-quant/gatew-soak/%i/control
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq-gatew-soak-failclose-%i
