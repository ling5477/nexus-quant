[Unit]
Description=NexusQuant GateW read-only soak worker (%i)
Documentation=file:/opt/nexus-quant/gatew-soak/app/repo/docs/current/evidence/gate-w/README.md
After=network.target
Wants=network.target
OnFailure=nq-gatew-soak-failclose@%i.service
OnSuccess=nq-gatew-soak-failclose@%i.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=nqgatew
Group=nqgatew
WorkingDirectory=/opt/nexus-quant/gatew-soak/app/repo
Environment=NQ_GATEW_REPO_ROOT=/opt/nexus-quant/gatew-soak/app/repo
Environment=NQ_GATEW_SECRET_SOURCE=SYSTEMD_CREDENTIALS
Environment=NQ_GATEW_FORMAL_SYSTEMD=true
EnvironmentFile=/var/lib/nexus-quant/gatew-soak/%i/control/worker.env
LoadCredentialEncrypted=db-password:/etc/nexus-quant/gatew-soak/credentials/db-password.cred
LoadCredentialEncrypted=credential-master-key:/etc/nexus-quant/gatew-soak/credentials/credential-master-key.cred
ExecStartPre=+/usr/bin/pwsh -NoProfile -File /usr/local/libexec/nexus-quant/gatew-okx-readonly-soak-control.ps1 -Action unit-preflight -RunId %i
ExecStart=/usr/bin/pwsh -NoProfile -File /usr/local/libexec/nexus-quant/gatew-okx-readonly-soak.ps1 -Action run-loop -RunId %i
ExecStopPost=+/usr/bin/pwsh -NoProfile -File /usr/local/libexec/nexus-quant/gatew-okx-readonly-soak-control.ps1 -Action record-exit -RunId %i -ServiceResult ${SERVICE_RESULT} -ExitCode ${EXIT_CODE} -ExitStatus ${EXIT_STATUS}
Restart=no
KillMode=mixed
TimeoutStartSec=10min
TimeoutStopSec=30s
RuntimeDirectory=nexus-quant/gatew-soak/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
StateDirectory=nexus-quant/gatew-soak/%i/evidence
StateDirectoryMode=0700
LogsDirectory=nexus-quant/gatew-soak/%i
LogsDirectoryMode=0700
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/nexus-quant/gatew-soak/app/repo
ReadOnlyPaths=/opt/nexus-quant/gatew-soak/app/launcher
# ExecStopPost 以 root 写 create-once exit fact；0700 root:root 仍阻止 nqgatew 访问 control。
ReadWritePaths=/var/lib/nexus-quant/gatew-soak/%i/control
ReadWritePaths=/run/nexus-quant/gatew-soak/%i
ReadWritePaths=/var/lib/nexus-quant/gatew-soak/%i/evidence
ReadWritePaths=/var/log/nexus-quant/gatew-soak/%i
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq-gatew-soak-%i
