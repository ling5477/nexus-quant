# GateJ-FREEZE environment template.
#
# Copy this file to `.env.freeze` on the server and replace every placeholder.
# Do not commit `.env.freeze`, real passwords, exchange credentials, cookies, or tokens.

# Base paths and timezone.
NQ_BASE_DIR=/opt/nexus-quant
TZ=Asia/Shanghai

# Frontend is exposed by nginx. Use 5179 for consistency with the local E2E port,
# or change to 80 only after confirming ECS security group rules.
FRONTEND_HTTP_PORT=5179

# Backend is only bound to 127.0.0.1 on the host. nginx reaches it through the
# Docker service name `nq-app`.
NQ_APP_HOST_PORT=18888
NQ_APP_PORT=18888
JAVA_OPTS="-Xms256m -Xmx768m"

# PostgreSQL runs as the Compose service `postgres`; do not use localhost here.
POSTGRES_DB=nexus_quant
POSTGRES_USER=nq_freeze
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
NQ_PROFILE=freeze
NQ_DB_URL=jdbc:postgresql://postgres:5432/nexus_quant
NQ_DB_USER=nq_freeze
NQ_DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Freeze account/security placeholders. Do not `source .env.freeze`; deployment
# scripts parse this file with Docker Compose or their own key/value reader.
# If the acceptance password contains shell metacharacters such as `>`, `)`,
# quotes, spaces, `$`, backticks, or `#`, keep the placeholder here and enter the
# password interactively when `scripts/seed-freeze-user.sh` prompts for it.
# The seed script consumes the password only to generate a BCrypt hash inside
# PostgreSQL; it is not shown in the frontend and `.env.freeze` is never
# committed.
NQ_SECURITY_ISSUER=nexus-quant-freeze
NQ_SECURITY_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_FOR_FREEZE
NQ_SECURITY_ACCESS_TOKEN_TTL=PT1H
NQ_ACCOUNT_CREDENTIALS_MASTER_KEY=CHANGE_ME_32_CHARS_ACCOUNT_MASTER_KEY
NQ_ACCOUNT_CREDENTIALS_KEY_VERSION=1
NQ_ACCOUNT_CREDENTIALS_VERIFICATION_MODE=STRUCTURAL
NQ_FREEZE_ADMIN_USERNAME=CHANGE_ME_FREEZE_ADMIN_USERNAME
NQ_FREEZE_ADMIN_PASSWORD=CHANGE_ME_FREEZE_ADMIN_PASSWORD

# Boundary switches required for GateJ-FREEZE.
# AI disabled: GateJ is Paper Trading stability only; AI starts no earlier than GateK.
NQ_AI_ENABLED=false
NQ_AI_SIGNAL_ENABLED=false
NQ_AI_PAPER_TRADING_ENABLED=false

# DH disabled: no DH integration or external notification bridge is part of GateJ-FREEZE.
NQ_DH_ENABLED=false

# REAL trading disabled: no LIVE order placement or real exchange order API calls.
NQ_REAL_TRADING_ENABLED=false
NQ_LIVE_TRADING_ENABLED=false
NQ_TRADING_ENV=SIM

# Exchange recovery and private streams disabled for freeze acceptance.
NQ_OKX_ENV=dome
NQ_OKX_API_KEY=
NQ_OKX_API_SECRET=
NQ_OKX_API_PASSPHRASE=
NQ_OKX_WS_ENABLED=false
NQ_OKX_RECOVERY_ENABLED=false
NQ_OKX_ADAPTER_STUB_ON_BOOTSTRAP_FAILURE=true
NQ_BINANCE_ENV=dome
NQ_BINANCE_WS_ENABLED=false
NQ_BINANCE_WS_DIAGNOSTIC_ENABLED=false
NQ_BINANCE_DOME_API_KEY=
NQ_BINANCE_DOME_API_SECRET=
NQ_BINANCE_REAL_API_KEY=
NQ_BINANCE_REAL_PRIVATE_KEY_PATH=

# Historical gated verification endpoints stay closed.
NQ_GATED_VERIFY_ENABLED=false
